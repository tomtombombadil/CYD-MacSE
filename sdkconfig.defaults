# Flash: 16 MB, four data lines at 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 8 MB octal PSRAM: the Mac's 4 MB RAM and 256 KB ROM live there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Biggest caches: the emulator's code (flash) and the Mac's RAM (PSRAM)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The RGB panel (cyd-classic-arcade's 5" settings)
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# The Mac runs flat out on core 1 when it is behind: no idle-task watchdog there
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Long file names on the SD card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# A crash saves a core dump to flash; the next start shows its summary
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Every free byte is filled (0xFE) and checked: a write into freed memory
# is caught by crash_report.c's checks (each second, after each disk transfer). (Watchpoint 0 is
# crash_report.c's, on the audio stack's end.)
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

# Wi-Fi (the log page) stays on core 0: core 1 is the Mac's
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
